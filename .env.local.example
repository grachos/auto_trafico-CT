# ==========================================
# CREDENCIALES CONTROLT (LOGIN AUTOMÁTICO OAUTH)
# ==========================================
# El sistema se loguea solo y auto-renueva el Bearer token cada vez que expira:
CONTROLT_USERNAME=tu_correo@empresa.com.co
CONTROLT_PASSWORD=tu_contraseña_aqui
CONTROLT_COMPANY_ID=616346

# URLs de ControlT (valores por defecto preconfigurados)
CONTROLT_AUTH_URL=https://app.controlt.com.co/apipublic/api/login/oauth
CONTROLT_API_BASE_URL=https://tower-api.controlt.com.co

# (Opcional) Si prefieres pasar un Bearer token fijo en lugar de user/pass:
# CONTROLT_BEARER_TOKEN=eyJhbGci...

# ==========================================
# BASE DE DATOS (SUPABASE / POSTGRESQL)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# ==========================================
# BOT DE TELEGRAM
# ==========================================
TELEGRAM_BOT_TOKEN=tu_token_de_botfather_aqui
TELEGRAM_WEBHOOK_SECRET=tu_secreto_seguro_aqui

# ==========================================
# GEMINI AI (MOTOR CONVERSACIONAL)
# ==========================================
GEMINI_API_KEY=tu_gemini_api_key_aqui
